<%- include('../partials/header') %>
<section class="space-y-6">
  <div class="rounded-xl border border-slate-800 bg-slate-900 p-6">
    <h1 class="text-2xl font-bold">Moderation Panel</h1>
    <p class="text-slate-300">Review reports, ban abusers, and inspect logs.</p>
  </div>

  <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 overflow-auto">
    <h2 class="text-lg font-semibold">Reports</h2>
    <table class="mt-3 w-full text-sm">
      <thead><tr class="text-left text-slate-400"><th>Target</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
      <% reports.forEach(report => { %>
        <tr class="border-t border-slate-800">
          <td class="py-2"><%= report.targetUsername %></td>
          <td><%= report.reason %></td>
          <td><%= report.status %></td>
          <td>
            <form method="post" action="/admin/reports/<%= report._id %>/review" class="flex gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <select name="decision" class="rounded bg-slate-800 p-1">
                <option value="approved">Approve</option><option value="rejected">Reject</option><option value="removed">Remove</option>
              </select>
              <input name="moderatorWeight" type="number" step="0.1" min="0" max="5" value="1" class="w-16 rounded bg-slate-800 p-1" />
              <button class="rounded bg-cyan-600 px-2">Save</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>

  <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 overflow-auto">
    <h2 class="text-lg font-semibold">Users</h2>
    <ul class="mt-2 space-y-2">
      <% users.forEach(user => { %>
        <li class="flex items-center justify-between rounded bg-slate-800 p-2">
          <span><%= user.username %> • <%= user.role %> • trust <%= user.trustScore %></span>
          <form method="post" action="/admin/users/<%= user._id %>/ban" class="flex gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label><input type="checkbox" name="shadow" value="1" /> Shadow</label>
            <button class="rounded bg-red-700 px-2">Ban</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
<%- include('../partials/footer') %>
