<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rivals Watch</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full">
<nav class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between p-4">
    <a href="/" class="font-bold text-cyan-400">Rivals Watch</a>
    <div class="flex items-center gap-3 text-sm">
      <% if (currentUser) { %>
        <span><%= currentUser.username %></span>
        <% if (currentUser.role === 'admin') { %><a href="/admin" class="text-cyan-300">Admin</a><% } %>
        <form method="post" action="/auth/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="rounded bg-slate-700 px-3 py-1">Logout</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="rounded bg-cyan-600 px-3 py-1">Sign in with Roblox</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="mx-auto max-w-6xl p-4">
