<%- include('partials/header') %>
<section class="grid gap-6 md:grid-cols-2">
  <div class="rounded-xl border border-slate-800 bg-slate-900 p-6">
    <h1 class="text-2xl font-bold">Roblox Rivals Account Reputation</h1>
    <p class="mt-2 text-slate-300">Lookup any username and inspect cheater likelihood.</p>
    <% if (error) { %><p class="mt-3 rounded bg-red-900/40 p-2 text-red-200"><%= error %></p><% } %>
    <form class="mt-4 flex gap-2" onsubmit="event.preventDefault();window.location='/u/'+encodeURIComponent(this.username.value)">
      <input required name="username" minlength="3" maxlength="20" class="w-full rounded bg-slate-800 p-2" placeholder="Enter Roblox username" />
      <button class="rounded bg-cyan-600 px-4">Search</button>
    </form>
  </div>
  <div class="rounded-xl border border-slate-800 bg-slate-900 p-6">
    <h2 class="text-lg font-semibold">Most Reported Leaderboard</h2>
    <ul class="mt-3 space-y-2">
      <% leaderboard.forEach(item => { %>
        <li class="flex justify-between rounded bg-slate-800 p-2">
          <a class="text-cyan-300" href="/u/<%= item.targetUsername %>">@<%= item.targetUsername %></a>
          <span><%= item.count %> reports</span>
        </li>
      <% }) %>
      <% if (!leaderboard.length) { %><li class="text-slate-400">No approved reports yet.</li><% } %>
    </ul>
  </div>
</section>
<%- include('partials/footer') %>
